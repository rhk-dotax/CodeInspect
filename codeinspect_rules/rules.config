# ════════════════════════════════════════════
#  CodeInspect 취약점 검출 규칙
# ════════════════════════════════════════════
#
#  형식:
#    - 주석은 '#' 으로 시작
#    - 각 규칙은 [RULE] 블록으로 구분
#    - key=value 한 줄 (값 안의 '=' 허용)
#
#  필드:
#    id          : 규칙 식별자 (고유)
#    languages   : c, cpp, java, csharp 중 하나 이상 (콤마 구분)
#    severity    : CRITICAL | HIGH | MEDIUM | LOW
#    category    : CWE 분류 (예: CWE-120 Buffer Overflow)
#    description : 한글 설명 (한 줄)
#    pattern     : 정규식 패턴 (한 줄, 이스케이프 없음)
#    options     : None | IgnoreCase | Multiline | Singleline (콤마 구분, 기본 Multiline)
#    reference   : 참조 출처 (선택, 예: semgrep:..., OWASP ASVS V6.2.5)
#
#  생성일시: 2026-04-22 16:32:16
#  규칙 수: 115

[RULE]
id=VUL-C-001
languages=c,cpp
severity=CRITICAL
category=CWE-120 Buffer Overflow
description=gets() 함수 사용 - 버퍼 오버플로 위험 (fgets 사용 권장)
pattern=\bgets\s*\(
options=Multiline

[RULE]
id=VUL-C-002
languages=c,cpp
severity=HIGH
category=CWE-120 Buffer Overflow
description=strcpy() 함수 사용 - 버퍼 크기 검증 없음 (strncpy/strlcpy 사용 권장)
pattern=\bstrcpy\s*\(
options=Multiline

[RULE]
id=VUL-C-003
languages=c,cpp
severity=HIGH
category=CWE-120 Buffer Overflow
description=strcat() 함수 사용 - 버퍼 크기 검증 없음 (strncat 사용 권장)
pattern=\bstrcat\s*\(
options=Multiline

[RULE]
id=VUL-C-004
languages=c,cpp
severity=HIGH
category=CWE-120 Buffer Overflow
description=sprintf() 함수 사용 - 버퍼 오버플로 위험 (snprintf 사용 권장)
pattern=\bsprintf\s*\(
options=Multiline

[RULE]
id=VUL-C-005
languages=c,cpp
severity=MEDIUM
category=CWE-120 Buffer Overflow
description=scanf() 포맷 문자열에 길이 제한 없음 - 버퍼 오버플로 위험
pattern=\bscanf\s*\(\s*"[^"]*%s
options=Multiline

[RULE]
id=VUL-C-006
languages=c,cpp
severity=MEDIUM
category=CWE-120 Buffer Overflow
description=vsprintf() 함수 사용 - 버퍼 오버플로 위험 (vsnprintf 사용 권장)
pattern=\bvsprintf\s*\(
options=Multiline

[RULE]
id=VUL-C-007
languages=c,cpp
severity=MEDIUM
category=CWE-120 Buffer Overflow
description=wcscpy() 함수 사용 - 와이드 문자 버퍼 오버플로 위험
pattern=\bwcscpy\s*\(
options=Multiline

[RULE]
id=VUL-C-008
languages=c,cpp
severity=MEDIUM
category=CWE-120 Buffer Overflow
description=wcscat() 함수 사용 - 와이드 문자 버퍼 오버플로 위험
pattern=\bwcscat\s*\(
options=Multiline

[RULE]
id=VUL-C-010
languages=c,cpp
severity=CRITICAL
category=CWE-134 Format String
description=printf()에 사용자 입력이 포맷 문자열로 직접 전달될 수 있음
pattern=\bprintf\s*\(\s*[a-zA-Z_]\w*\s*\)
options=Multiline

[RULE]
id=VUL-C-011
languages=c,cpp
severity=CRITICAL
category=CWE-134 Format String
description=fprintf()에 사용자 입력이 포맷 문자열로 직접 전달될 수 있음
pattern=\bfprintf\s*\(\s*\w+\s*,\s*[a-zA-Z_]\w*\s*\)
options=Multiline

[RULE]
id=VUL-C-012
languages=c,cpp
severity=HIGH
category=CWE-134 Format String
description=syslog()에 사용자 입력이 포맷 문자열로 직접 전달될 수 있음
pattern=\bsyslog\s*\(\s*\w+\s*,\s*[a-zA-Z_]\w*\s*\)
options=Multiline

[RULE]
id=VUL-C-020
languages=c,cpp
severity=HIGH
category=CWE-401 Memory Leak
description=malloc() 반환값 NULL 체크 누락 가능성
pattern==\s*malloc\s*\([^)]*\)\s*;
options=Multiline

[RULE]
id=VUL-C-021
languages=c,cpp
severity=HIGH
category=CWE-401 Memory Leak
description=calloc() 반환값 NULL 체크 누락 가능성
pattern==\s*calloc\s*\([^)]*\)\s*;
options=Multiline

[RULE]
id=VUL-C-022
languages=c,cpp
severity=HIGH
category=CWE-401 Memory Leak
description=realloc() 반환값 NULL 체크 누락 가능성
pattern==\s*realloc\s*\([^)]*\)\s*;
options=Multiline

[RULE]
id=VUL-C-023
languages=c,cpp
severity=MEDIUM
category=CWE-415 Double Free
description=free() 후 포인터 NULL 초기화 누락 - Double Free 위험
pattern=\bfree\s*\(\s*\w+\s*\)\s*;
options=Multiline

[RULE]
id=VUL-C-030
languages=c,cpp
severity=MEDIUM
category=CWE-190 Integer Overflow
description=atoi() 함수 사용 - 오류 처리 없음 (strtol 사용 권장)
pattern=\batoi\s*\(
options=Multiline

[RULE]
id=VUL-C-031
languages=c,cpp
severity=MEDIUM
category=CWE-190 Integer Overflow
description=atol() 함수 사용 - 오류 처리 없음 (strtol 사용 권장)
pattern=\batol\s*\(
options=Multiline

[RULE]
id=VUL-C-040
languages=c,cpp
severity=MEDIUM
category=CWE-367 TOCTOU Race Condition
description=access() 사용 - TOCTOU 경쟁 조건 위험
pattern=\baccess\s*\(
options=Multiline

[RULE]
id=VUL-C-041
languages=c,cpp
severity=HIGH
category=CWE-377 Insecure Temp File
description=mktemp() 함수 사용 - 안전하지 않은 임시 파일 생성 (mkstemp 사용 권장)
pattern=\bmktemp\s*\(
options=Multiline

[RULE]
id=VUL-C-042
languages=c,cpp
severity=MEDIUM
category=CWE-377 Insecure Temp File
description=tmpnam() 함수 사용 - 안전하지 않은 임시 파일명 생성
pattern=\btmpnam\s*\(
options=Multiline

[RULE]
id=VUL-C-050
languages=c,cpp
severity=CRITICAL
category=CWE-78 OS Command Injection
description=system() 함수 사용 - 명령어 인젝션 위험
pattern=\bsystem\s*\(
options=Multiline

[RULE]
id=VUL-C-051
languages=c,cpp
severity=CRITICAL
category=CWE-78 OS Command Injection
description=popen() 함수 사용 - 명령어 인젝션 위험
pattern=\bpopen\s*\(
options=Multiline

[RULE]
id=VUL-C-052
languages=c,cpp
severity=HIGH
category=CWE-78 OS Command Injection
description=exec 계열 함수 사용 - 명령어 인젝션 위험
pattern=\b(execl|execle|execlp|execv|execve|execvp)\s*\(
options=Multiline

[RULE]
id=VUL-C-060
languages=c,cpp
severity=MEDIUM
category=CWE-330 Insufficient Randomness
description=rand()/srand() 사용 - 보안 목적에 부적합한 난수 생성기
pattern=\b(rand|srand)\s*\(
options=Multiline

[RULE]
id=VUL-JAVA-001
languages=java
severity=CRITICAL
category=CWE-89 SQL Injection
description=문자열 연결을 통한 SQL 쿼리 생성 - SQL 인젝션 위험 (PreparedStatement 사용 권장)
pattern=(?:executeQuery|executeUpdate|execute)\s*\(\s*(?:"[^"]*"\s*\+|\w+\s*\+\s*")
options=Multiline

[RULE]
id=VUL-JAVA-002
languages=java
severity=CRITICAL
category=CWE-89 SQL Injection
description=Statement.execute에 문자열 변수 직접 전달 - SQL 인젝션 위험
pattern=\.(?:executeQuery|executeUpdate|execute)\s*\(\s*[a-zA-Z_]\w*\s*\)
options=Multiline

[RULE]
id=VUL-JAVA-003
languages=java
severity=HIGH
category=CWE-89 SQL Injection
description=createQuery()에 문자열 연결 사용 - HQL/JPQL 인젝션 위험
pattern=\.createQuery\s*\(\s*(?:"[^"]*"\s*\+|\w+\s*\+)
options=Multiline

[RULE]
id=VUL-JAVA-004
languages=java
severity=HIGH
category=CWE-89 SQL Injection
description=createNativeQuery()에 문자열 연결 사용 - SQL 인젝션 위험
pattern=\.createNativeQuery\s*\(\s*(?:"[^"]*"\s*\+|\w+\s*\+)
options=Multiline

[RULE]
id=VUL-JAVA-010
languages=java
severity=CRITICAL
category=CWE-78 OS Command Injection
description=Runtime.exec() 사용 - 명령어 인젝션 위험
pattern=Runtime\.getRuntime\(\)\s*\.\s*exec\s*\(
options=Multiline

[RULE]
id=VUL-JAVA-011
languages=java
severity=CRITICAL
category=CWE-78 OS Command Injection
description=ProcessBuilder 사용 - 명령어 인젝션 위험 확인 필요
pattern=new\s+ProcessBuilder\s*\(
options=Multiline

[RULE]
id=VUL-JAVA-020
languages=java
severity=HIGH
category=CWE-79 XSS
description=getParameter() 값을 직접 출력 - XSS 위험 (HTML 이스케이프 필요)
pattern=getParameter\s*\(\s*"[^"]*"\s*\)
options=Multiline

[RULE]
id=VUL-JAVA-021
languages=java
severity=HIGH
category=CWE-79 XSS
description=response.getWriter()로 직접 출력 - XSS 위험
pattern=getWriter\s*\(\s*\)\s*\.\s*(?:print|println|write)\s*\(
options=Multiline

[RULE]
id=VUL-JAVA-030
languages=java
severity=CRITICAL
category=CWE-502 Deserialization
description=ObjectInputStream.readObject() 사용 - 신뢰할 수 없는 데이터 역직렬화 위험
pattern=\.readObject\s*\(\s*\)
options=Multiline

[RULE]
id=VUL-JAVA-031
languages=java
severity=HIGH
category=CWE-502 Deserialization
description=XMLDecoder 사용 - XML 역직렬화 공격 위험
pattern=new\s+XMLDecoder\s*\(
options=Multiline

[RULE]
id=VUL-JAVA-040
languages=java
severity=HIGH
category=CWE-22 Path Traversal
description=new File()에 사용자 입력 사용 가능성 - 경로 순회 위험
pattern=new\s+File\s*\(\s*(?:request\.getParameter|input|userInput|fileName|filePath|path)
options=Multiline

[RULE]
id=VUL-JAVA-050
languages=java
severity=HIGH
category=CWE-327 Broken Crypto
description=DES 알고리즘 사용 - 취약한 암호화 (AES 사용 권장)
pattern=Cipher\.getInstance\s*\(\s*"(?:DES|DESede)
options=Multiline

[RULE]
id=VUL-JAVA-051
languages=java
severity=HIGH
category=CWE-327 Broken Crypto
description=ECB 모드 사용 - 안전하지 않은 암호화 모드 (CBC/GCM 사용 권장)
pattern=Cipher\.getInstance\s*\(\s*"[^"]*\/ECB\/
options=Multiline

[RULE]
id=VUL-JAVA-052
languages=java
severity=HIGH
category=CWE-328 Weak Hash
description=MD5 해시 사용 - 취약한 해시 알고리즘 (SHA-256 이상 사용 권장)
pattern=MessageDigest\.getInstance\s*\(\s*"MD5"\s*\)
options=Multiline

[RULE]
id=VUL-JAVA-053
languages=java
severity=MEDIUM
category=CWE-328 Weak Hash
description=SHA-1 해시 사용 - 취약한 해시 알고리즘 (SHA-256 이상 사용 권장)
pattern=MessageDigest\.getInstance\s*\(\s*"SHA-?1"\s*\)
options=Multiline

[RULE]
id=VUL-JAVA-054
languages=java
severity=MEDIUM
category=CWE-330 Insufficient Randomness
description=java.util.Random 사용 - 보안 목적에 부적합 (SecureRandom 사용 권장)
pattern=new\s+Random\s*\(
options=Multiline

[RULE]
id=VUL-JAVA-060
languages=java
severity=HIGH
category=CWE-798 Hard-coded Credentials
description=하드코딩된 패스워드 감지
pattern=(?:password|passwd|pwd)\s*=\s*"[^"]{3,}"
options=IgnoreCase,Multiline

[RULE]
id=VUL-JAVA-061
languages=java
severity=HIGH
category=CWE-798 Hard-coded Credentials
description=하드코딩된 비밀키/토큰 감지
pattern=(?:secret|secretKey|api_key|apiKey|token)\s*=\s*"[^"]{8,}"
options=IgnoreCase,Multiline

[RULE]
id=VUL-JAVA-070
languages=java
severity=MEDIUM
category=CWE-532 Info Exposure Through Log
description=e.printStackTrace() 사용 - 민감 정보 노출 위험 (로거 사용 권장)
pattern=\.printStackTrace\s*\(\s*\)
options=Multiline

[RULE]
id=VUL-JAVA-100
languages=java
severity=HIGH
category=CWE-611 XXE
description=XML 파서 외부 엔티티 처리 활성화 가능성 - XXE 공격 위험
pattern=(?:DocumentBuilderFactory|SAXParserFactory|XMLInputFactory)\.newInstance\s*\(
options=Multiline

[RULE]
id=VUL-CS-001
languages=csharp
severity=CRITICAL
category=CWE-89 SQL Injection
description=문자열 연결/보간을 통한 SQL 쿼리 생성 - SQL 인젝션 위험 (SqlParameter 사용 권장)
pattern=(?:SqlCommand|OleDbCommand|OdbcCommand)\s*\(\s*(?:"[^"]*"\s*\+|\w+\s*\+|.*?\$")
options=Multiline

[RULE]
id=VUL-CS-002
languages=csharp
severity=CRITICAL
category=CWE-89 SQL Injection
description=ExecuteSqlRaw/FromSqlRaw에 문자열 보간 사용 - SQL 인젝션 위험
pattern=(?:ExecuteSqlRaw|FromSqlRaw)\s*\(\s*\$"
options=Multiline

[RULE]
id=VUL-CS-003
languages=csharp
severity=HIGH
category=CWE-89 SQL Injection
description=CommandText에 문자열 연결 사용 - SQL 인젝션 위험
pattern=CommandText\s*=\s*(?:"[^"]*"\s*\+|\$"|.*?\+\s*\w+)
options=Multiline

[RULE]
id=VUL-CS-010
languages=csharp
severity=HIGH
category=CWE-79 XSS
description=Response.Write()에 사용자 입력 직접 출력 가능성 - XSS 위험
pattern=Response\.Write\s*\(
options=Multiline

[RULE]
id=VUL-CS-011
languages=csharp
severity=HIGH
category=CWE-79 XSS
description=Html.Raw() 사용 - XSS 위험 (인코딩 없는 출력)
pattern=Html\.Raw\s*\(
options=Multiline

[RULE]
id=VUL-CS-020
languages=csharp
severity=CRITICAL
category=CWE-78 OS Command Injection
description=Process.Start() 사용 - 명령어 인젝션 위험 확인 필요
pattern=Process\.Start\s*\(
options=Multiline

[RULE]
id=VUL-CS-021
languages=csharp
severity=HIGH
category=CWE-78 OS Command Injection
description=ProcessStartInfo에 cmd.exe/powershell 사용 - 명령어 인젝션 위험
pattern=(?:FileName|Arguments)\s*=\s*.*?(?:cmd|powershell|bash)
options=IgnoreCase,Multiline

[RULE]
id=VUL-CS-030
languages=csharp
severity=CRITICAL
category=CWE-502 Deserialization
description=BinaryFormatter 사용 - 안전하지 않은 역직렬화 (JsonSerializer 사용 권장)
pattern=BinaryFormatter
options=Multiline

[RULE]
id=VUL-CS-031
languages=csharp
severity=HIGH
category=CWE-502 Deserialization
description=JavaScriptSerializer 사용 - TypeNameHandling 취약점 위험
pattern=JavaScriptSerializer
options=Multiline

[RULE]
id=VUL-CS-032
languages=csharp
severity=HIGH
category=CWE-502 Deserialization
description=TypeNameHandling.All 사용 - 역직렬화 공격 위험
pattern=TypeNameHandling\s*=\s*TypeNameHandling\.(?:All|Auto|Objects|Arrays)
options=Multiline

[RULE]
id=VUL-CS-040
languages=csharp
severity=HIGH
category=CWE-327 Broken Crypto
description=DES/TripleDES 사용 - 취약한 암호화 (Aes 사용 권장)
