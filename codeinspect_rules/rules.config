options=Multiline

[RULE]
id=VUL-CS-041
languages=csharp
severity=HIGH
category=CWE-328 Weak Hash
description=MD5 해시 사용 - 취약한 해시 알고리즘 (SHA256 이상 사용 권장)
pattern=MD5\.Create\s*\(\s*\)
options=Multiline

[RULE]
id=VUL-CS-042
languages=csharp
severity=MEDIUM
category=CWE-328 Weak Hash
description=SHA1 해시 사용 - 취약한 해시 알고리즘 (SHA256 이상 사용 권장)
pattern=SHA1\.Create\s*\(\s*\)
options=Multiline

[RULE]
id=VUL-CS-050
languages=csharp
severity=HIGH
category=CWE-798 Hard-coded Credentials
description=하드코딩된 연결 문자열에 패스워드 포함
pattern=(?:connectionString|ConnectionString)\s*=\s*"[^"]*(?:password|pwd)\s*=\s*[^";]+
options=IgnoreCase,Multiline

[RULE]
id=VUL-CS-051
languages=csharp
severity=HIGH
category=CWE-798 Hard-coded Credentials
description=하드코딩된 패스워드 감지
pattern=(?:password|passwd|pwd)\s*=\s*"[^"]{3,}"
options=IgnoreCase,Multiline

[RULE]
id=VUL-CS-060
languages=csharp
severity=HIGH
category=CWE-22 Path Traversal
description=Path.Combine에 사용자 입력 사용 가능성 - 경로 순회 위험
pattern=Path\.Combine\s*\(.*?(?:Request|input|user|param)
options=IgnoreCase,Multiline

[RULE]
id=VUL-CS-080
languages=csharp
severity=HIGH
category=CWE-611 XXE
description=XmlDocument DtdProcessing 활성화 - XXE 공격 위험
pattern=DtdProcessing\s*=\s*DtdProcessing\.Parse
options=Multiline

[RULE]
id=VUL-CS-081
languages=csharp
severity=HIGH
category=CWE-611 XXE
description=XmlTextReader 사용 - XXE 위험 확인 필요
pattern=new\s+XmlTextReader\s*\(
options=Multiline

[RULE]
id=VUL-CS-090
languages=csharp
severity=MEDIUM
category=CWE-352 CSRF
description=[HttpPost]에 [ValidateAntiForgeryToken] 누락 가능성
pattern=\[HttpPost\](?!\s*\r?\n\s*\[ValidateAntiForgeryToken\])
options=Multiline

[RULE]
id=VUL-CS-100
languages=csharp
severity=MEDIUM
category=CWE-209 Error Info Exposure
description=예외 메시지 직접 반환 - 민감 정보 노출 위험
pattern=(?:return|Response\.Write|Content)\s*\(?\s*(?:ex|exception)\.(?:Message|StackTrace|ToString)
options=Multiline

[RULE]
id=VUL-COM-001
languages=c,cpp,java,csharp
severity=HIGH
category=CWE-798 Hard-coded Credentials
description=하드코딩된 IP 주소 감지 - 설정 파일 분리 권장
pattern=(?:"|')[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(?:"|')
options=Multiline

[RULE]
id=VUL-COM-002
languages=c,cpp,java,csharp
severity=LOW
category=CWE-561 Dead Code
description=TODO/FIXME/HACK/XXX 주석 감지 - 잠재적 미완성 코드
pattern=(?://|/\*)\s*(?:TODO|FIXME|HACK|XXX|BUG)\b
options=IgnoreCase,Multiline

[RULE]
id=SG-JAVA-001
languages=java
severity=HIGH
category=CWE-327 Broken Crypto
description=MD5 메시지 다이제스트 사용 (Semgrep: use-of-md5)
pattern=MessageDigest\.getInstance\s*\(\s*"MD5"
options=Multiline
reference=semgrep:java.lang.security.audit.crypto.use-of-md5.use-of-md5

[RULE]
id=SG-JAVA-002
languages=java
severity=MEDIUM
category=CWE-328 Weak Hash
description=SHA-1 메시지 다이제스트 사용 (Semgrep: use-of-sha1)
pattern=MessageDigest\.getInstance\s*\(\s*"SHA-?1"
options=Multiline
reference=semgrep:java.lang.security.audit.crypto.use-of-sha1.use-of-sha1

[RULE]
id=SG-JAVA-003
languages=java
